# Reply Core configuration. Copy to .env or export in the shell; every value is optional.
# Data home (database, backups, state). Default: ~/Library/Application Support/reply-core
REPLY_CORE_HOME=
# Loopback port, 1024-65535. Default: 45511
REPLY_CORE_PORT=45511
# debug | info | warn | error. Default: info
REPLY_CORE_LOG_LEVEL=info
# Write logs to this file (rotated at REPLY_CORE_LOG_MAX_BYTES, default 10485760, keeping 5 files) instead of stdout.
# The launcher (scripts/reply-core) sets it to ~/Library/Logs/reply-core/service.log.
REPLY_CORE_LOG_FILE=
REPLY_CORE_LOG_MAX_BYTES=
# Extra browser origins allowed to call the API, comma separated (for example a UI dev server).
# The service's own origin (http://127.0.0.1:<port>, http://localhost:<port>) is always allowed.
REPLY_CORE_ALLOWED_ORIGINS=
# Connectors to run, comma separated (for example: imessage,apple-mail). Unset or empty: imessage,contacts,apple-mail. `none`: no connectors. `stub` is a demo connector.
REPLY_CORE_CONNECTORS=
# Messages database (default: ~/Library/Messages/chat.db) and native helper binary
REPLY_CORE_IMESSAGE_DB=
# Apple Mail data folder (default: ~/Library/Mail)
REPLY_CORE_MAIL_ROOT=
# WhatsApp Desktop database (auto-detected when empty). Add whatsapp to REPLY_CORE_CONNECTORS to enable it.
REPLY_CORE_WHATSAPP_DB=
REPLY_CORE_HELPER=
# Per-connector interval in ms (>= 1000), for example REPLY_CORE_IMESSAGE_INTERVAL_MS=60000
# Country code used for phone numbers without a country prefix (for example HU, US, GB). Default: HU
REPLY_CORE_DEFAULT_REGION=HU
# IMAP mailboxes are added with: node bin/reply-core.js accounts add-imap --host <host> --user <user>
# (REPLY_CORE_IMAP_INTERVAL_MS=300000 changes how often they sync)

# Folder with the built web app (default: core/ui/dist)
REPLY_CORE_UI_DIR=

# Optional reply suggestions from a local model. off (default) or ollama.
REPLY_CORE_LLM=off
# Required when REPLY_CORE_LLM=ollama, for example llama3.1:8b
REPLY_CORE_OLLAMA_MODEL=
REPLY_CORE_OLLAMA_URL=http://127.0.0.1:11434
# Set to 1 only to allow a model that is NOT on this Mac (conversation text would leave it)
REPLY_CORE_ALLOW_REMOTE_LLM=
