{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/moldovancsaba/reply/core/schema/api-read.json",
  "title": "Reply Core read API responses",
  "definitions": {
    "channel": {
      "enum": [
        "imessage",
        "email",
        "whatsapp"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imessage",
        "email",
        "whatsapp"
      ],
      "properties": {
        "imessage": {
          "type": "integer",
          "minimum": 0
        },
        "email": {
          "type": "integer",
          "minimum": 0
        },
        "whatsapp": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "handle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "label",
        "kind"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "phone",
            "email",
            "whatsapp",
            "other"
          ]
        }
      }
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "ContactListItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "lastTs",
        "lastChannel",
        "lastPreview",
        "lastFromMe",
        "counts",
        "countTotal",
        "handles"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "lastTs": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "lastChannel": {
          "anyOf": [
            {
              "$ref": "#/definitions/channel"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastPreview": {
          "type": "string",
          "maxLength": 140
        },
        "lastFromMe": {
          "type": "boolean"
        },
        "counts": {
          "$ref": "#/definitions/counts"
        },
        "countTotal": {
          "type": "integer",
          "minimum": 0
        },
        "handles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/handle"
          }
        }
      }
    },
    "ContactList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "nextCursor",
        "hasMore",
        "total"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ContactListItem"
          }
        },
        "nextCursor": {
          "$ref": "#/definitions/cursor"
        },
        "hasMore": {
          "type": "boolean"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "origin",
        "counts",
        "countTotal",
        "handles"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "origin": {
          "enum": [
            "auto",
            "apple_contacts",
            "manual"
          ]
        },
        "counts": {
          "$ref": "#/definitions/counts"
        },
        "countTotal": {
          "type": "integer",
          "minimum": 0
        },
        "handles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/handle"
          }
        },
        "replyChannels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "channel",
              "handles",
              "send"
            ],
            "properties": {
              "channel": {
                "$ref": "#/definitions/channel"
              },
              "handles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value",
                    "label",
                    "default"
                  ],
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "default": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "send": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "available"
                ],
                "properties": {
                  "available": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "ThreadMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "channel",
        "isFromMe",
        "ts",
        "text",
        "attachments",
        "counterpartHandle"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "channel": {
          "$ref": "#/definitions/channel"
        },
        "isFromMe": {
          "type": "boolean"
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "subject": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "isSummary": {
          "const": true
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "mimeType": {
                "type": "string"
              },
              "bytes": {
                "type": "integer"
              }
            }
          }
        },
        "counterpartHandle": {
          "type": "string"
        },
        "sender": {
          "type": "string"
        },
        "senderName": {
          "type": "string"
        }
      }
    },
    "Thread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "nextCursor",
        "hasMore"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ThreadMessage"
          }
        },
        "nextCursor": {
          "$ref": "#/definitions/cursor"
        },
        "hasMore": {
          "type": "boolean"
        }
      }
    },
    "SearchHit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageId",
        "contactId",
        "contactName",
        "channel",
        "ts",
        "snippet"
      ],
      "properties": {
        "messageId": {
          "type": "string"
        },
        "contactId": {
          "type": "string"
        },
        "contactName": {
          "type": "string"
        },
        "channel": {
          "$ref": "#/definitions/channel"
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "snippet": {
          "type": "string",
          "maxLength": 170
        }
      }
    },
    "SearchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "nextCursor",
        "hasMore"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SearchHit"
          }
        },
        "nextCursor": {
          "$ref": "#/definitions/cursor"
        },
        "hasMore": {
          "type": "boolean"
        }
      }
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "requestId",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "requestId": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          }
        }
      }
    },
    "ProfileFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profession",
        "company",
        "relationship",
        "linkedinUrl",
        "intro",
        "updatedAt"
      ],
      "properties": {
        "profession": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "relationship": {
          "type": "string"
        },
        "linkedinUrl": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      }
    },
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "origin",
        "card",
        "profile",
        "notes",
        "handles",
        "stats",
        "mergedFrom",
        "members"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "origin": {
          "enum": [
            "auto",
            "apple_contacts",
            "manual"
          ]
        },
        "card": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "givenName": {
              "type": "string"
            },
            "familyName": {
              "type": "string"
            },
            "nickname": {
              "type": "string"
            },
            "organization": {
              "type": "string"
            },
            "jobTitle": {
              "type": "string"
            },
            "department": {
              "type": "string"
            },
            "birthday": {
              "type": "string"
            },
            "urls": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "addresses": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "profile": {
          "$ref": "#/definitions/ProfileFields"
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Note"
          }
        },
        "handles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "label",
              "kind",
              "origin",
              "messages",
              "lastTs"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "phone",
                  "email",
                  "whatsapp",
                  "other"
                ]
              },
              "origin": {
                "enum": [
                  "auto",
                  "apple_contacts",
                  "manual_merge"
                ]
              },
              "messages": {
                "type": "integer",
                "minimum": 0
              },
              "lastTs": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "sent",
            "received",
            "firstTs",
            "lastTs",
            "lastSentTs",
            "lastReceivedTs",
            "last30Days",
            "byChannel"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "sent": {
              "type": "integer",
              "minimum": 0
            },
            "received": {
              "type": "integer",
              "minimum": 0
            },
            "firstTs": {
              "type": [
                "string",
                "null"
              ]
            },
            "lastTs": {
              "type": [
                "string",
                "null"
              ]
            },
            "lastSentTs": {
              "type": [
                "string",
                "null"
              ]
            },
            "lastReceivedTs": {
              "type": [
                "string",
                "null"
              ]
            },
            "last30Days": {
              "type": "integer",
              "minimum": 0
            },
            "byChannel": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "imessage",
                "email",
                "whatsapp"
              ],
              "properties": {
                "imessage": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "total",
                    "sent",
                    "received",
                    "firstTs",
                    "lastTs"
                  ],
                  "properties": {
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sent": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "received": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "firstTs": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "lastTs": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "email": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "total",
                    "sent",
                    "received",
                    "firstTs",
                    "lastTs"
                  ],
                  "properties": {
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sent": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "received": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "firstTs": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "lastTs": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "whatsapp": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "total",
                    "sent",
                    "received",
                    "firstTs",
                    "lastTs"
                  ],
                  "properties": {
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sent": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "received": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "firstTs": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "lastTs": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "mergedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "handle",
              "name",
              "admin",
              "messages",
              "contactId"
            ],
            "properties": {
              "handle": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "admin": {
                "type": "boolean"
              },
              "messages": {
                "type": "integer",
                "minimum": 0
              },
              "contactId": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
