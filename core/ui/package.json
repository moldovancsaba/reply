    "@mantine/notifications": "^7.17.8",
    "@sovereignsquad/gds": "^6.8.0",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.4",
    "dayjs": "^1.11.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sovereignsquad/gds-a11y": "^6.8.0",
    "@sovereignsquad/gds-eslint-config": "^6.8.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:api": "node scripts/gen-api-types.mjs",
    "verify": "npm run gen:api && git diff --exit-code src/api/types.gen.ts && npm run lint && npm run typecheck && npm test && npm run build && npm run check:bundle && npm run test:e2e",
    "check:bundle": "node scripts/check-bundle.mjs"
  }
