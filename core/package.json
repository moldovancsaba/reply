{
  "name": "reply-core",
  "version": "0.1.0",
  "private": true,
  "description": "Reply Core: lean local-first unified inbox service",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "reply-core": "bin/reply-core.js"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test test/*.test.js",
    "verify": "node scripts/verify.js",
    "fixtures": "node test/fixtures/build.js",
    "ui:build": "npm --prefix ui run build",
    "verify:ui": "npm --prefix ui run verify"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "imapflow": "^2.5.5",
    "libphonenumber-js": "^1.13.15",
    "mailparser": "^3.9.46",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "hoodiecrow-imap": "^3.3.1"
  }
}
